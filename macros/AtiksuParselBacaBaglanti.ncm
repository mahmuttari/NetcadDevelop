'===========================================================================
' ATIKSU PARSEL BACA BAGLANTI BILGILERI YAZMA MAKROSU
' NetCAD NCM Macro
'
' Islem Sirasi:
'   1. C baglanti noktasi secilir
'   2. Parsel baca noktasi secilir
'   3. Ikisi arasindaki hat cizgisi secilir
'   4. C noktasi zemin noktasi secilir (ZK ve AK okunur)
'   5. Parsel bacasi zemin noktasi secilir (ZK ve AK okunur)
'   6. Bilgiler hesaplanir ve gorseldeki formatta yazilir
'
' Yazilan Bilgiler:
'   - Baca Adi (ornek: BPB107)
'   - Zemin Kotu ZK (ornek: ZK:23.70)
'   - Akar Kotu AK (ornek: AK:22.30)
'   - Yatay Mesafe YL (ornek: YL=6.15m)
'   - Egik Mesafe EL (ornek: EL=6.26m)
'   - Hat Capi (sabit: Ø200BB)
'===========================================================================

Sub Main()

    Dim cBagX
    Dim cBagY
    Dim cBagZ
    Dim parselX
    Dim parselY
    Dim parselZ
    Dim cZeminX
    Dim cZeminY
    Dim pZeminX
    Dim pZeminY
    Dim cNoktaAdi
    Dim parselBacaAdi
    Dim cZK
    Dim cAK
    Dim pZK
    Dim pAK
    Dim hatYatayMesafe
    Dim hatEgikMesafe
    Dim hatAci
    Dim hatAciDerece
    Dim deltaZ
    Dim dx
    Dim dy
    Dim entId
    Dim entType
    Dim sonuc
    Dim yaziX
    Dim yaziY
    Dim perpX
    Dim perpY
    Dim satirSayaci
    Dim yaziAci
    Dim zkMetin
    Dim akMetin
    Dim ylMetin
    Dim elMetin
    Dim cZkMetin
    Dim cAkMetin
    Dim ortaX
    Dim ortaY
    Dim mesafeMetin
    Dim mesafeYaziX
    Dim mesafeYaziY
    Dim tx
    Dim ty
    Dim myPI
    Dim yaziYukseklik
    Dim satirAraligi
    Dim noktaOffset
    Dim yaziRenk
    Dim hatCapiMetin

    ' Yapilandirma
    myPI = 3.14159265358979
    yaziYukseklik = 0.35
    satirAraligi = 0.55
    noktaOffset = 0.5
    yaziRenk = 6
    hatCapiMetin = "Ø200BB"

    ' -------------------------------------------------------
    ' 1. ADIM: C Baglanti Noktasini Sec
    ' -------------------------------------------------------
    sonuc = NCInputPoint("1/5 - C baglanti noktasini secin:", cBagX, cBagY, cBagZ)
    If Not sonuc Then
        MsgBox "Islem iptal edildi."
        Exit Sub
    End If

    ' -------------------------------------------------------
    ' 2. ADIM: Parsel Baca Noktasini Sec
    ' -------------------------------------------------------
    sonuc = NCInputPoint("2/5 - Parsel baca noktasini secin:", parselX, parselY, parselZ)
    If Not sonuc Then
        MsgBox "Islem iptal edildi."
        Exit Sub
    End If

    ' -------------------------------------------------------
    ' 3. ADIM: Hat Cizgisini Sec
    ' -------------------------------------------------------
    sonuc = NCInputEntity("3/5 - Hat cizgisini secin:", entType, entId)
    If Not sonuc Then
        MsgBox "Islem iptal edildi."
        Exit Sub
    End If

    hatYatayMesafe = NCGetLineLength2D(entId)
    hatEgikMesafe = NCGetLineLength3D(entId)

    ' -------------------------------------------------------
    ' 4. ADIM: C Noktasi Zemin Noktasini Sec
    ' -------------------------------------------------------
    sonuc = NCInputEntity("4/5 - C noktasinin zemin noktasini secin:", entType, entId)
    If Not sonuc Then
        MsgBox "Islem iptal edildi."
        Exit Sub
    End If

    cNoktaAdi = NCGetEntityName(entId)
    cZK = NCGetEntityZ(entId)
    cAK = NCGetProperty(entId, "AK")
    NCGetEntityPos entId, cZeminX, cZeminY

    ' -------------------------------------------------------
    ' 5. ADIM: Parsel Bacasi Zemin Noktasini Sec
    ' -------------------------------------------------------
    sonuc = NCInputEntity("5/5 - Parsel bacasi zemin noktasini secin:", entType, entId)
    If Not sonuc Then
        MsgBox "Islem iptal edildi."
        Exit Sub
    End If

    parselBacaAdi = NCGetEntityName(entId)
    pZK = NCGetEntityZ(entId)
    pAK = NCGetProperty(entId, "AK")
    NCGetEntityPos entId, pZeminX, pZeminY

    ' -------------------------------------------------------
    ' Hesaplamalar
    ' -------------------------------------------------------
    dx = parselX - cBagX
    dy = parselY - cBagY
    hatAci = Atn2(dy, dx)
    hatAciDerece = hatAci * 57.2957795130823

    ' Egik mesafe dogrulamasi
    If hatEgikMesafe <= 0 Then
        deltaZ = Abs(pZK - cZK)
        hatEgikMesafe = Sqr(hatYatayMesafe * hatYatayMesafe + deltaZ * deltaZ)
    End If

    ' Yazi acisi (okunaklilik icin -90 ile 90 derece arasinda)
    yaziAci = hatAciDerece
    If yaziAci > 90 Then
        yaziAci = yaziAci - 180
    End If
    If yaziAci < -90 Then
        yaziAci = yaziAci + 180
    End If

    ' Dik yon (text offseti icin)
    perpX = -Sin(hatAci)
    perpY = Cos(hatAci)

    ' -------------------------------------------------------
    ' PARSEL BACA BILGILERINI YAZ (Baca noktasinda)
    ' -------------------------------------------------------
    NCSetColor yaziRenk
    satirSayaci = 0

    yaziX = parselX + perpX * noktaOffset
    yaziY = parselY + perpY * noktaOffset

    ' Satir 0: Baca Adi
    tx = yaziX + perpX * satirAraligi * satirSayaci
    ty = yaziY + perpY * satirAraligi * satirSayaci
    NCCreateText parselBacaAdi, tx, ty, yaziYukseklik, yaziAci
    satirSayaci = satirSayaci + 1

    ' Satir 1: Zemin Kotu
    zkMetin = "ZK:" & FormatNumber(pZK, 2)
    tx = yaziX + perpX * satirAraligi * satirSayaci
    ty = yaziY + perpY * satirAraligi * satirSayaci
    NCCreateText zkMetin, tx, ty, yaziYukseklik, yaziAci
    satirSayaci = satirSayaci + 1

    ' Satir 2: Akar Kotu
    akMetin = "AK:" & FormatNumber(pAK, 2)
    tx = yaziX + perpX * satirAraligi * satirSayaci
    ty = yaziY + perpY * satirAraligi * satirSayaci
    NCCreateText akMetin, tx, ty, yaziYukseklik, yaziAci
    satirSayaci = satirSayaci + 1

    ' Satir 3: Yatay Mesafe
    ylMetin = "YL=" & FormatNumber(hatYatayMesafe, 2) & "m"
    tx = yaziX + perpX * satirAraligi * satirSayaci
    ty = yaziY + perpY * satirAraligi * satirSayaci
    NCCreateText ylMetin, tx, ty, yaziYukseklik, yaziAci
    satirSayaci = satirSayaci + 1

    ' Satir 4: Egik Mesafe
    elMetin = "EL=" & FormatNumber(hatEgikMesafe, 2) & "m"
    tx = yaziX + perpX * satirAraligi * satirSayaci
    ty = yaziY + perpY * satirAraligi * satirSayaci
    NCCreateText elMetin, tx, ty, yaziYukseklik, yaziAci
    satirSayaci = satirSayaci + 1

    ' Satir 5: Hat Capi (sabit)
    tx = yaziX + perpX * satirAraligi * satirSayaci
    ty = yaziY + perpY * satirAraligi * satirSayaci
    NCCreateText hatCapiMetin, tx, ty, yaziYukseklik, yaziAci

    ' -------------------------------------------------------
    ' C BAGLANTI NOKTASI BILGILERINI YAZ
    ' -------------------------------------------------------
    satirSayaci = 0

    yaziX = cBagX + perpX * noktaOffset
    yaziY = cBagY + perpY * noktaOffset

    ' C Nokta Adi
    tx = yaziX + perpX * satirAraligi * satirSayaci
    ty = yaziY + perpY * satirAraligi * satirSayaci
    NCCreateText cNoktaAdi, tx, ty, yaziYukseklik, yaziAci
    satirSayaci = satirSayaci + 1

    ' C Zemin Kotu
    cZkMetin = "ZK:" & FormatNumber(cZK, 2)
    tx = yaziX + perpX * satirAraligi * satirSayaci
    ty = yaziY + perpY * satirAraligi * satirSayaci
    NCCreateText cZkMetin, tx, ty, yaziYukseklik, yaziAci
    satirSayaci = satirSayaci + 1

    ' C Akar Kotu
    cAkMetin = "AK:" & FormatNumber(cAK, 2)
    tx = yaziX + perpX * satirAraligi * satirSayaci
    ty = yaziY + perpY * satirAraligi * satirSayaci
    NCCreateText cAkMetin, tx, ty, yaziYukseklik, yaziAci

    ' -------------------------------------------------------
    ' HAT ORTASINA MESAFE BILGISI YAZ
    ' -------------------------------------------------------
    ortaX = (cBagX + parselX) / 2
    ortaY = (cBagY + parselY) / 2

    mesafeMetin = FormatNumber(hatYatayMesafe, 2)

    mesafeYaziX = ortaX + perpX * (noktaOffset * 0.5)
    mesafeYaziY = ortaY + perpY * (noktaOffset * 0.5)

    NCCreateText mesafeMetin, mesafeYaziX, mesafeYaziY, yaziYukseklik, yaziAci

    ' -------------------------------------------------------
    ' Islem tamamlandi
    ' -------------------------------------------------------
    MsgBox "Baca: " & parselBacaAdi & " | C: " & cNoktaAdi & " | YL=" & FormatNumber(hatYatayMesafe, 2) & "m | EL=" & FormatNumber(hatEgikMesafe, 2) & "m"

End Sub

' ===========================================================================
' Atn2 fonksiyonu
' ===========================================================================
Function Atn2(y, x)
    Dim myPI
    myPI = 3.14159265358979
    If x > 0 Then
        Atn2 = Atn(y / x)
    ElseIf x < 0 And y >= 0 Then
        Atn2 = Atn(y / x) + myPI
    ElseIf x < 0 And y < 0 Then
        Atn2 = Atn(y / x) - myPI
    ElseIf x = 0 And y > 0 Then
        Atn2 = myPI / 2
    ElseIf x = 0 And y < 0 Then
        Atn2 = -myPI / 2
    Else
        Atn2 = 0
    End If
End Function
