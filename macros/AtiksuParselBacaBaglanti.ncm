'===========================================================================
' ATIKSU PARSEL BACA BAGLANTI BILGILERI YAZMA MAKROSU
' NetCAD VBScript Macro
'
' Islem Sirasi:
'   1. Hat cizgisi secilir (yatay ve egik mesafe okunur)
'   2. C zemin noktasi secilir (ad, ZK, AK okunur)
'   3. Parsel baca zemin noktasi secilir (ad, ZK, AK okunur)
'   4. Parsel Baca text grubu icin yerlestirme noktasi secilir
'   5. C Baglanti text grubu icin yerlestirme noktasi secilir
'   6. Devam/Cik
'
' Text Gruplari:
'   PARSEL BACA (6 satir): Ad, ZK, AK, YL, EL, Cap
'   C BAGLANTI  (3 satir): Ad, ZK, AK
'===========================================================================

SUB Main

DIM selHat, selNokta, selYer
DIM o, oHat, oC, oBaca, oYer
DIM i, j, bd
DIM cNoktaAdi, parselBacaAdi
DIM cZK, cAK, pZK, pAK
DIM hatYatayMesafe, hatEgikMesafe
DIM yaziboy, satirar, hatcapi
DIM hatAci, yaziAci, perpX, perpY
DIM yerX, yerY, tx, ty
DIM tabNo, devamMi, sayac
DIM deltaZ, dx, dy, myPI

myPI = 3.14159265358979
sayac = 0

With netcad

  ' -----------------------------------------------------------
  ' AYAR DIYALOGU
  ' -----------------------------------------------------------
  set bd = Netcad.NewBDialog("Atiksu Parsel Baca Baglanti Ayarlari")
  bd.Getfloat "yaziboy", "Yazi Yuksekligi:", 0.35, 2
  bd.Getfloat "satirar", "Satir Araligi:", 0.55, 2
  bd.Getstring "hatcapi", "Hat Capi Metni:", "Ø200BB", 20

  If Not bd.showmodal Then
    Exit Sub
  End If

  yaziboy = bd.ValueByName("yaziboy")
  satirar = bd.ValueByName("satirar")
  hatcapi = bd.ValueByName("hatcapi")

  tabNo = .CreateLayer("PARSEL_BACA_BILGI", 6)

  ' ===========================================================
  ' ANA DONGU
  ' ===========================================================
  devamMi = True

  Do While devamMi

    sayac = sayac + 1

    set selHat = .NewSelectionSet
    set selNokta = .NewSelectionSet
    set selYer = .NewSelectionSet
    set o = .NewObject
    set oHat = .NewObject
    set oC = .NewObject
    set oBaca = .NewObject
    set oYer = .NewObject

    .setparam beginblock, true

    ' ---------------------------------------------------------
    ' 1. HAT CIZGISINI SEC
    ' ---------------------------------------------------------
    If Not selHat.SELECT("1/5 - Hat cizgisini secin", array(opline)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selHat.GetSelectedObject(0, oHat)
    hatYatayMesafe = oHat.length
    hatEgikMesafe = oHat.length3d

    ' ---------------------------------------------------------
    ' 2. C ZEMIN NOKTASINI SEC
    ' ---------------------------------------------------------
    If Not selNokta.SELECT("2/5 - C noktasinin zemin noktasini secin", array(oppoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selNokta.GetSelectedObject(0, oC)
    cNoktaAdi = oC.pname
    cZK = oC.z

    ' AK degerini oku
    cAK = 0
    On Error Resume Next
    cAK = oC.pcode
    On Error GoTo 0
    If cAK = 0 Or cAK = "" Then
      cAK = CDbl(InputBox("C noktasi (" & cNoktaAdi & ") Akar Kotu (AK) girin:", "AK Girisi", "0.00"))
    End If

    ' ---------------------------------------------------------
    ' 3. PARSEL BACA ZEMIN NOKTASINI SEC
    ' ---------------------------------------------------------
    set selNokta = .NewSelectionSet
    If Not selNokta.SELECT("3/5 - Parsel bacasi zemin noktasini secin", array(oppoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selNokta.GetSelectedObject(0, oBaca)
    parselBacaAdi = oBaca.pname
    pZK = oBaca.z

    ' AK degerini oku
    pAK = 0
    On Error Resume Next
    pAK = oBaca.pcode
    On Error GoTo 0
    If pAK = 0 Or pAK = "" Then
      pAK = CDbl(InputBox("Parsel bacasi (" & parselBacaAdi & ") Akar Kotu (AK) girin:", "AK Girisi", "0.00"))
    End If

    ' ---------------------------------------------------------
    ' HESAPLAMALAR
    ' ---------------------------------------------------------
    dx = oBaca.x - oC.x
    dy = oBaca.y - oC.y

    If dx = 0 And dy = 0 Then
      hatAci = 0
    ElseIf dx = 0 Then
      If dy > 0 Then hatAci = myPI / 2 Else hatAci = -myPI / 2
    Else
      hatAci = Atn(dy / dx)
      If dx < 0 Then hatAci = hatAci + myPI
    End If

    ' Egik mesafe kontrolu
    If hatEgikMesafe <= 0 Or hatEgikMesafe = hatYatayMesafe Then
      deltaZ = Abs(pZK - cZK)
      If deltaZ > 0 Then
        hatEgikMesafe = Sqr(hatYatayMesafe * hatYatayMesafe + deltaZ * deltaZ)
      End If
    End If

    ' Yazi acisi (okunaklilik icin -90/+90)
    yaziAci = hatAci * 57.2957795130823
    If yaziAci > 90 Then yaziAci = yaziAci - 180
    If yaziAci < -90 Then yaziAci = yaziAci + 180

    ' Dik yon (satir offseti icin)
    perpX = -Sin(hatAci)
    perpY = Cos(hatAci)

    ' ---------------------------------------------------------
    ' 4. PARSEL BACA TEXT GRUBUNU YERLESTIR (6 satir)
    '    Kullanici bir nokta objesi secer, text oraya yazilir
    ' ---------------------------------------------------------
    set selYer = .NewSelectionSet
    If Not selYer.SELECT("4/5 - PARSEL BACA text grubunu koyacaginiz NOKTAYI secin", array(oppoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selYer.GetSelectedObject(0, oYer)
    yerX = oYer.x
    yerY = oYer.y

    ' Satir 0: Baca Adi
    tx = yerX
    ty = yerY
    .AddObject (.MakeText (.MakeCoord(tx, ty, 0), parselBacaAdi, yaziAci, 0, yaziboy, 0, "L", tabNo))

    ' Satir 1: Zemin Kotu
    tx = yerX + perpX * satirar
    ty = yerY + perpY * satirar
    .AddObject (.MakeText (.MakeCoord(tx, ty, 0), "ZK:" & KotFormat(pZK), yaziAci, 0, yaziboy, 0, "L", tabNo))

    ' Satir 2: Akar Kotu
    tx = yerX + perpX * satirar * 2
    ty = yerY + perpY * satirar * 2
    .AddObject (.MakeText (.MakeCoord(tx, ty, 0), "AK:" & KotFormat(pAK), yaziAci, 0, yaziboy, 0, "L", tabNo))

    ' Satir 3: Yatay Mesafe
    tx = yerX + perpX * satirar * 3
    ty = yerY + perpY * satirar * 3
    .AddObject (.MakeText (.MakeCoord(tx, ty, 0), "YL=" & KotFormat(hatYatayMesafe) & "m", yaziAci, 0, yaziboy, 0, "L", tabNo))

    ' Satir 4: Egik Mesafe
    tx = yerX + perpX * satirar * 4
    ty = yerY + perpY * satirar * 4
    .AddObject (.MakeText (.MakeCoord(tx, ty, 0), "EL=" & KotFormat(hatEgikMesafe) & "m", yaziAci, 0, yaziboy, 0, "L", tabNo))

    ' Satir 5: Hat Capi
    tx = yerX + perpX * satirar * 5
    ty = yerY + perpY * satirar * 5
    .AddObject (.MakeText (.MakeCoord(tx, ty, 0), hatcapi, yaziAci, 0, yaziboy, 0, "L", tabNo))

    ' ---------------------------------------------------------
    ' 5. C BAGLANTI TEXT GRUBUNU YERLESTIR (3 satir)
    ' ---------------------------------------------------------
    set selYer = .NewSelectionSet
    If Not selYer.SELECT("5/5 - C BAGLANTI text grubunu koyacaginiz NOKTAYI secin", array(oppoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selYer.GetSelectedObject(0, oYer)
    yerX = oYer.x
    yerY = oYer.y

    ' Satir 0: C Nokta Adi
    tx = yerX
    ty = yerY
    .AddObject (.MakeText (.MakeCoord(tx, ty, 0), cNoktaAdi, yaziAci, 0, yaziboy, 0, "L", tabNo))

    ' Satir 1: C Zemin Kotu
    tx = yerX + perpX * satirar
    ty = yerY + perpY * satirar
    .AddObject (.MakeText (.MakeCoord(tx, ty, 0), "ZK:" & KotFormat(cZK), yaziAci, 0, yaziboy, 0, "L", tabNo))

    ' Satir 2: C Akar Kotu
    tx = yerX + perpX * satirar * 2
    ty = yerY + perpY * satirar * 2
    .AddObject (.MakeText (.MakeCoord(tx, ty, 0), "AK:" & KotFormat(cAK), yaziAci, 0, yaziboy, 0, "L", tabNo))

    ' ---------------------------------------------------------
    .setparam endblock, true

    ' ---------------------------------------------------------
    ' DEVAM KONTROLU
    ' ---------------------------------------------------------
    Dim sorgu
    sorgu = MsgBox("Baglanti #" & sayac & " tamamlandi." & Chr(13) & Chr(13) & "Baca: " & parselBacaAdi & Chr(13) & "C: " & cNoktaAdi & Chr(13) & Chr(13) & "Devam?", 4, "Parsel Baca Makrosu")

    If sorgu = 6 Then
      devamMi = True
    Else
      devamMi = False
    End If

    set selHat = Nothing
    set selNokta = Nothing
    set selYer = Nothing
    set o = Nothing

  Loop

End With

MsgBox "Toplam " & sayac & " baglanti islendi.", 64, "Parsel Baca Makrosu"

END SUB

' ===========================================================================
Function KotFormat(deger)
  Dim tamKisim, ondalikKisim, tempDeger, isaret

  If deger < 0 Then
    isaret = "-"
    tempDeger = -deger
  Else
    isaret = ""
    tempDeger = CDbl(deger)
  End If

  tamKisim = Int(tempDeger)
  ondalikKisim = Int((tempDeger - tamKisim) * 100 + 0.5)

  If ondalikKisim >= 100 Then
    tamKisim = tamKisim + 1
    ondalikKisim = 0
  End If

  If ondalikKisim < 10 Then
    KotFormat = isaret & CStr(tamKisim) & ".0" & CStr(ondalikKisim)
  Else
    KotFormat = isaret & CStr(tamKisim) & "." & CStr(ondalikKisim)
  End If
End Function
