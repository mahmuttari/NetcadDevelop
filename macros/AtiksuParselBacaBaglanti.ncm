'===========================================================================
' ATIKSU PARSEL BACA BAGLANTI BILGILERI YAZMA MAKROSU
' NetCAD VBScript Macro
'===========================================================================

SUB Main

DIM selHat, selNokta
DIM oHat, oC, oCAK, oBaca, oBacaAK
DIM j, k, bd, pExt, cr, yaz, lay
DIM cNoktaAdi, parselBacaAdi
DIM cZK, cAK, pZK, pAK
DIM hatYatayMesafe, hatEgikMesafe
DIM yaziboy, satirar, hatcapi
DIM yerX, yerY
DIM devamMi, sayac
DIM deltaZ, dx, dy, dz
DIM sorgu, mesaj

sayac = 0

With netcad

  set bd = Netcad.NewBDialog("Atiksu Parsel Baca Baglanti Ayarlari")
  bd.Getfloat "yaziboy", "Yazi Yuksekligi:", 2, 2
  bd.Getfloat "satirar", "Satir Araligi:", 3, 2
  bd.Getstring "hatcapi", "Hat Capi Metni:", "O200BB", 20

  If Not bd.showmodal Then
    Exit Sub
  End If

  yaziboy = bd.ValueByName("yaziboy")
  satirar = bd.ValueByName("satirar")
  hatcapi = bd.ValueByName("hatcapi")

  MsgBox "DEBUG: Yaziboy=" & yaziboy & "  Satirar=" & satirar, 64, "Debug"

  devamMi = True

  Do While devamMi

    sayac = sayac + 1

    .setparam beginblock, true

    ' 1. HAT CIZGISINI SEC
    set selHat = .NewSelectionSet
    set oHat = .NewObject

    If Not selHat.SELECT("1/7 - Hat cizgisini secin", Array(oline, opline)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selHat.GetSelectedObject(0, oHat)

    hatYatayMesafe = 0
    hatEgikMesafe = 0

    If oHat.tag = oline Then
      dx = oHat.p2.x - oHat.p1.x
      dy = oHat.p2.y - oHat.p1.y
      dz = oHat.p2.z - oHat.p1.z
      hatYatayMesafe = Sqr(dx * dx + dy * dy)
      hatEgikMesafe = Sqr(dx * dx + dy * dy + dz * dz)
    ElseIf oHat.tag = opline Then
      set pExt = .GetPlineExt(oHat)
      For k = 0 To pExt.num - 2
        dx = pExt.cor(k + 1).x - pExt.cor(k).x
        dy = pExt.cor(k + 1).y - pExt.cor(k).y
        dz = pExt.cor(k + 1).z - pExt.cor(k).z
        hatYatayMesafe = hatYatayMesafe + Sqr(dx * dx + dy * dy)
        hatEgikMesafe = hatEgikMesafe + Sqr(dx * dx + dy * dy + dz * dz)
      Next
    End If

    ' 2. C ZEMIN KOTU NOKTASINI SEC
    set selNokta = .NewSelectionSet
    set oC = .NewObject
    If Not selNokta.SELECT("2/7 - C noktasinin ZEMIN KOTU noktasini secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If
    j = selNokta.GetSelectedObject(0, oC)
    cNoktaAdi = oC.pname
    cZK = oC.p1.z

    ' 3. C AKAR KOTU NOKTASINI SEC
    set selNokta = .NewSelectionSet
    set oCAK = .NewObject
    If Not selNokta.SELECT("3/7 - C noktasinin AKAR KOTU noktasini secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If
    j = selNokta.GetSelectedObject(0, oCAK)
    cAK = oCAK.p1.z

    ' 4. PARSEL BACA ZEMIN KOTU NOKTASINI SEC
    set selNokta = .NewSelectionSet
    set oBaca = .NewObject
    If Not selNokta.SELECT("4/7 - Parsel bacasi ZEMIN KOTU noktasini secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If
    j = selNokta.GetSelectedObject(0, oBaca)
    parselBacaAdi = oBaca.pname
    pZK = oBaca.p1.z

    ' 5. PARSEL BACA AKAR KOTU NOKTASINI SEC
    set selNokta = .NewSelectionSet
    set oBacaAK = .NewObject
    If Not selNokta.SELECT("5/7 - Parsel bacasi AKAR KOTU noktasini secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If
    j = selNokta.GetSelectedObject(0, oBacaAK)
    pAK = oBacaAK.p1.z

    ' HESAPLAMALAR
    If hatEgikMesafe <= 0 Or hatEgikMesafe = hatYatayMesafe Then
      deltaZ = Abs(pZK - cZK)
      If deltaZ > 0 Then
        hatEgikMesafe = Sqr(hatYatayMesafe * hatYatayMesafe + deltaZ * deltaZ)
      End If
    End If

    ' 6. PARSEL BACA TEXT GRUBU - ekrandan serbest tikla
    set cr = .newc(0, 0, 0)
    If Not .SelectPoint("6/7 - PARSEL BACA textleri icin ekrana tiklayin", cr, -1) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    yerX = cr.x
    yerY = cr.y

    lay = .CreateLayer("PARSEL_BACA_BILGI", 6)

    set yaz = .MakeText(.newc(yerX, yerY, 0), parselBacaAdi, 0, 0, yaziboy, 0, "M", lay)
    .AddObject yaz
    set yaz = .MakeText(.newc(yerX, yerY - satirar, 0), "ZK:" & KotFormat(pZK), 0, 0, yaziboy, 0, "M", lay)
    .AddObject yaz
    set yaz = .MakeText(.newc(yerX, yerY - satirar * 2, 0), "AK:" & KotFormat(pAK), 0, 0, yaziboy, 0, "M", lay)
    .AddObject yaz
    set yaz = .MakeText(.newc(yerX, yerY - satirar * 3, 0), "YL=" & KotFormat(hatYatayMesafe) & "m", 0, 0, yaziboy, 0, "M", lay)
    .AddObject yaz
    set yaz = .MakeText(.newc(yerX, yerY - satirar * 4, 0), "EL=" & KotFormat(hatEgikMesafe) & "m", 0, 0, yaziboy, 0, "M", lay)
    .AddObject yaz
    set yaz = .MakeText(.newc(yerX, yerY - satirar * 5, 0), hatcapi, 0, 0, yaziboy, 0, "M", lay)
    .AddObject yaz

    .NetcadCommand "REDRAW"

    ' 7. C BAGLANTI TEXT GRUBU - ekrandan serbest tikla
    set cr = .newc(0, 0, 0)
    If Not .SelectPoint("7/7 - C BAGLANTI textleri icin ekrana tiklayin", cr, -1) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    yerX = cr.x
    yerY = cr.y

    set yaz = .MakeText(.newc(yerX, yerY, 0), cNoktaAdi, 0, 0, yaziboy, 0, "M", lay)
    .AddObject yaz
    set yaz = .MakeText(.newc(yerX, yerY - satirar, 0), "ZK:" & KotFormat(cZK), 0, 0, yaziboy, 0, "M", lay)
    .AddObject yaz
    set yaz = .MakeText(.newc(yerX, yerY - satirar * 2, 0), "AK:" & KotFormat(cAK), 0, 0, yaziboy, 0, "M", lay)
    .AddObject yaz

    .NetcadCommand "REDRAW"

    .setparam endblock, true

    ' DEVAM KONTROLU
    mesaj = "Baglanti #" & sayac & " tamamlandi." & Chr(13) & Chr(13)
    mesaj = mesaj & "Baca: " & parselBacaAdi & " ZK:" & KotFormat(pZK) & " AK:" & KotFormat(pAK) & Chr(13)
    mesaj = mesaj & "C: " & cNoktaAdi & " ZK:" & KotFormat(cZK) & " AK:" & KotFormat(cAK) & Chr(13)
    mesaj = mesaj & "YL=" & KotFormat(hatYatayMesafe) & "m  EL=" & KotFormat(hatEgikMesafe) & "m" & Chr(13) & Chr(13)
    mesaj = mesaj & "Devam?"

    sorgu = MsgBox(mesaj, 4, "Parsel Baca Makrosu")

    If sorgu = 6 Then
      devamMi = True
    Else
      devamMi = False
    End If

  Loop

End With

MsgBox "Toplam " & sayac & " baglanti islendi.", 64, "Parsel Baca Makrosu"

END SUB

Function KotFormat(deger)
  Dim tamKisim, ondalikKisim, tempDeger, isaret

  If deger < 0 Then
    isaret = "-"
    tempDeger = -deger
  Else
    isaret = ""
    tempDeger = CDbl(deger)
  End If

  tamKisim = Int(tempDeger)
  ondalikKisim = Int((tempDeger - tamKisim) * 100 + 0.5)

  If ondalikKisim >= 100 Then
    tamKisim = tamKisim + 1
    ondalikKisim = 0
  End If

  If ondalikKisim < 10 Then
    KotFormat = isaret & CStr(tamKisim) & ".0" & CStr(ondalikKisim)
  Else
    KotFormat = isaret & CStr(tamKisim) & "." & CStr(ondalikKisim)
  End If
End Function
