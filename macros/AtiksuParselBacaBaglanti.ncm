'===========================================================================
' ATIKSU PARSEL BACA BAGLANTI BILGILERI YAZMA MAKROSU
' NetCAD NCM Macro
'
' Islem Sirasi:
'   1. C baglanti noktasi secilir
'   2. Parsel baca noktasi secilir
'   3. Hat cizgisi secilir
'   4. C zemin noktasi secilir (ad, ZK, AK okunur)
'   5. Parsel baca zemin noktasi secilir (ad, ZK, AK okunur)
'   6. Parsel Baca Text Grubu yerlestirilecek nokta secilir
'   7. C Baglanti Text Grubu yerlestirilecek nokta secilir
'   8. Devam/Cik secenegi
'
' Text Gruplari:
'   PARSEL BACA (6 satir): Ad, ZK, AK, YL, EL, Cap
'   C BAGLANTI  (3 satir): Ad, ZK, AK
'===========================================================================

Sub Main()

    Dim cBagX
    Dim cBagY
    Dim cBagZ
    Dim parselX
    Dim parselY
    Dim parselZ
    Dim cNoktaAdi
    Dim parselBacaAdi
    Dim cZK
    Dim cAK
    Dim pZK
    Dim pAK
    Dim hatYatayMesafe
    Dim hatEgikMesafe
    Dim hatAci
    Dim hatAciDerece
    Dim deltaZ
    Dim dx
    Dim dy
    Dim entId
    Dim entType
    Dim sonuc
    Dim perpX
    Dim perpY
    Dim yaziAci
    Dim tx
    Dim ty
    Dim metin
    Dim devamMi
    Dim yaziYukseklik
    Dim satirAraligi
    Dim yaziRenk
    Dim hatCapiMetin
    Dim katmanAdi
    Dim tempVal
    Dim sayac
    Dim yerX
    Dim yerY
    Dim yerZ

    ' Yapilandirma
    yaziYukseklik = 0.35
    satirAraligi = 0.55
    yaziRenk = 6
    hatCapiMetin = "Ø200BB"
    katmanAdi = "PARSEL_BACA_BILGI"
    sayac = 0

    ' Kullanicidan yapilandirma
    tempVal = InputBox("Yazi yuksekligi (varsayilan 0.35):", "Ayarlar", "0.35")
    If tempVal <> "" Then
        yaziYukseklik = CDbl(tempVal)
    End If

    tempVal = InputBox("Satir araligi (varsayilan 0.55):", "Ayarlar", "0.55")
    If tempVal <> "" Then
        satirAraligi = CDbl(tempVal)
    End If

    tempVal = InputBox("Hat capi metni (varsayilan Ø200BB):", "Ayarlar", "Ø200BB")
    If tempVal <> "" Then
        hatCapiMetin = tempVal
    End If

    ' ===============================================================
    ' ANA DONGU
    ' ===============================================================
    devamMi = True

    Do While devamMi

        sayac = sayac + 1

        ' -----------------------------------------------------------
        ' 1. C Baglanti Noktasini Sec
        ' -----------------------------------------------------------
        sonuc = NCInputPoint("1/5 - C baglanti noktasini secin:", cBagX, cBagY, cBagZ)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        ' -----------------------------------------------------------
        ' 2. Parsel Baca Noktasini Sec
        ' -----------------------------------------------------------
        sonuc = NCInputPoint("2/5 - Parsel baca noktasini secin:", parselX, parselY, parselZ)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        ' -----------------------------------------------------------
        ' 3. Hat Cizgisini Sec
        ' -----------------------------------------------------------
        sonuc = NCInputEntity("3/5 - Hat cizgisini secin:", entType, entId)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        hatYatayMesafe = NCGetLineLength2D(entId)
        hatEgikMesafe = NCGetLineLength3D(entId)

        ' -----------------------------------------------------------
        ' 4. C Zemin Noktasini Sec
        ' -----------------------------------------------------------
        sonuc = NCInputEntity("4/5 - C noktasinin zemin noktasini secin:", entType, entId)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        cNoktaAdi = NCGetEntityName(entId)
        cZK = NCGetEntityZ(entId)
        cAK = 0
        On Error Resume Next
        cAK = NCGetProperty(entId, "AK")
        On Error GoTo 0
        If cAK = 0 Then
            tempVal = InputBox("C noktasi (" & cNoktaAdi & ") AK degeri:" & Chr(13) & "Akar Kotu girin:", "AK Girisi", "0.00")
            If tempVal <> "" Then
                cAK = CDbl(tempVal)
            End If
        End If

        ' -----------------------------------------------------------
        ' 5. Parsel Baca Zemin Noktasini Sec
        ' -----------------------------------------------------------
        sonuc = NCInputEntity("5/5 - Parsel bacasi zemin noktasini secin:", entType, entId)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        parselBacaAdi = NCGetEntityName(entId)
        pZK = NCGetEntityZ(entId)
        pAK = 0
        On Error Resume Next
        pAK = NCGetProperty(entId, "AK")
        On Error GoTo 0
        If pAK = 0 Then
            tempVal = InputBox("Parsel bacasi (" & parselBacaAdi & ") AK degeri:" & Chr(13) & "Akar Kotu girin:", "AK Girisi", "0.00")
            If tempVal <> "" Then
                pAK = CDbl(tempVal)
            End If
        End If

        ' -----------------------------------------------------------
        ' Hesaplamalar
        ' -----------------------------------------------------------
        dx = parselX - cBagX
        dy = parselY - cBagY
        hatAci = HesaplaAtn2(dy, dx)
        hatAciDerece = hatAci * 57.2957795130823

        If hatEgikMesafe <= 0 Then
            deltaZ = Abs(pZK - cZK)
            hatEgikMesafe = Sqr(hatYatayMesafe * hatYatayMesafe + deltaZ * deltaZ)
        End If

        ' Yazi acisi (okunaklilik icin -90 / +90 arasi)
        yaziAci = hatAciDerece
        If yaziAci > 90 Then
            yaziAci = yaziAci - 180
        End If
        If yaziAci < -90 Then
            yaziAci = yaziAci + 180
        End If

        ' Dik yon
        perpX = -Sin(hatAci)
        perpY = Cos(hatAci)

        NCSetColor yaziRenk

        ' ===========================================================
        ' PARSEL BACA TEXT GRUBUNU YERLESTIR (6 satir)
        ' Kullanici fare ile yerlestirme noktasini secer
        ' ===========================================================
        sonuc = NCInputPoint("PARSEL BACA text grubunu yerlestirecek noktayi secin:", yerX, yerY, yerZ)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        ' Satir 0: Baca Adi
        tx = yerX
        ty = yerY
        NCCreateText parselBacaAdi, tx, ty, yaziYukseklik, yaziAci

        ' Satir 1: Zemin Kotu
        tx = yerX + perpX * satirAraligi * 1
        ty = yerY + perpY * satirAraligi * 1
        metin = "ZK:" & KotFormat(pZK)
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci

        ' Satir 2: Akar Kotu
        tx = yerX + perpX * satirAraligi * 2
        ty = yerY + perpY * satirAraligi * 2
        metin = "AK:" & KotFormat(pAK)
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci

        ' Satir 3: Yatay Mesafe
        tx = yerX + perpX * satirAraligi * 3
        ty = yerY + perpY * satirAraligi * 3
        metin = "YL=" & KotFormat(hatYatayMesafe) & "m"
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci

        ' Satir 4: Egik Mesafe
        tx = yerX + perpX * satirAraligi * 4
        ty = yerY + perpY * satirAraligi * 4
        metin = "EL=" & KotFormat(hatEgikMesafe) & "m"
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci

        ' Satir 5: Hat Capi
        tx = yerX + perpX * satirAraligi * 5
        ty = yerY + perpY * satirAraligi * 5
        NCCreateText hatCapiMetin, tx, ty, yaziYukseklik, yaziAci

        ' ===========================================================
        ' C BAGLANTI TEXT GRUBUNU YERLESTIR (3 satir)
        ' Kullanici fare ile yerlestirme noktasini secer
        ' ===========================================================
        sonuc = NCInputPoint("C BAGLANTI text grubunu yerlestirecek noktayi secin:", yerX, yerY, yerZ)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        ' Satir 0: C Nokta Adi
        tx = yerX
        ty = yerY
        NCCreateText cNoktaAdi, tx, ty, yaziYukseklik, yaziAci

        ' Satir 1: C Zemin Kotu
        tx = yerX + perpX * satirAraligi * 1
        ty = yerY + perpY * satirAraligi * 1
        metin = "ZK:" & KotFormat(cZK)
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci

        ' Satir 2: C Akar Kotu
        tx = yerX + perpX * satirAraligi * 2
        ty = yerY + perpY * satirAraligi * 2
        metin = "AK:" & KotFormat(cAK)
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci

        ' -----------------------------------------------------------
        ' Devam kontrolu
        ' -----------------------------------------------------------
        tempVal = MsgBox("Baglanti #" & sayac & " tamamlandi." & Chr(13) & Chr(13) & "Baca: " & parselBacaAdi & Chr(13) & "C: " & cNoktaAdi & Chr(13) & Chr(13) & "Devam etmek ister misiniz?", 4, "Parsel Baca Makrosu")

        If tempVal = 6 Then
            devamMi = True
        Else
            devamMi = False
        End If

    Loop

    MsgBox "Makro tamamlandi. Toplam " & sayac & " baglanti islendi."

End Sub

' ===========================================================================
Function KotFormat(deger)
    Dim tamKisim
    Dim ondalikKisim
    Dim tempDeger
    Dim isaret

    If deger < 0 Then
        isaret = "-"
        tempDeger = -deger
    Else
        isaret = ""
        tempDeger = deger
    End If

    tamKisim = Int(tempDeger)
    ondalikKisim = Int((tempDeger - tamKisim) * 100 + 0.5)

    If ondalikKisim >= 100 Then
        tamKisim = tamKisim + 1
        ondalikKisim = 0
    End If

    If ondalikKisim < 10 Then
        KotFormat = isaret & CStr(tamKisim) & ".0" & CStr(ondalikKisim)
    Else
        KotFormat = isaret & CStr(tamKisim) & "." & CStr(ondalikKisim)
    End If
End Function

' ===========================================================================
Function HesaplaAtn2(y, x)
    Dim myPI
    myPI = 3.14159265358979
    If x > 0 Then
        HesaplaAtn2 = Atn(y / x)
    ElseIf x < 0 And y >= 0 Then
        HesaplaAtn2 = Atn(y / x) + myPI
    ElseIf x < 0 And y < 0 Then
        HesaplaAtn2 = Atn(y / x) - myPI
    ElseIf x = 0 And y > 0 Then
        HesaplaAtn2 = myPI / 2
    ElseIf x = 0 And y < 0 Then
        HesaplaAtn2 = -myPI / 2
    Else
        HesaplaAtn2 = 0
    End If
End Function
