'===========================================================================
' ATIKSU PARSEL BACA BAGLANTI BILGILERI YAZMA MAKROSU
' NetCAD VBScript Macro
'
' Islem Sirasi:
'   1. Hat cizgisi secilir (yatay ve egik mesafe hesaplanir)
'   2. C zemin kotu noktasi secilir (ad ve ZK okunur)
'   3. C akar kotu noktasi secilir (AK okunur)
'   4. Parsel baca zemin kotu noktasi secilir (ad ve ZK okunur)
'   5. Parsel baca akar kotu noktasi secilir (AK okunur)
'   6. Ekrandan tiklanarak PARSEL BACA text grubu yerlestirilir
'   7. Ekrandan tiklanarak C BAGLANTI text grubu yerlestirilir
'   8. Devam/Cik
'
' Text Gruplari (dik, alt alta):
'   PARSEL BACA (6 satir): Ad, ZK, AK, YL, EL, Cap
'   C BAGLANTI  (3 satir): Ad, ZK, AK
'===========================================================================

SUB Main

DIM selHat, selNokta
DIM oHat, oC, oCAK, oBaca, oBacaAK
DIM i, j, k, bd, pExt, cr
DIM cNoktaAdi, parselBacaAdi
DIM cZK, cAK, pZK, pAK
DIM hatYatayMesafe, hatEgikMesafe
DIM yaziboy, satirar, hatcapi
DIM yerX, yerY
DIM tabNo, devamMi, sayac
DIM deltaZ, dx, dy, dz

sayac = 0

With netcad

  ' -----------------------------------------------------------
  ' AYAR DIYALOGU
  ' -----------------------------------------------------------
  set bd = Netcad.NewBDialog("Atiksu Parsel Baca Baglanti Ayarlari")
  bd.Getfloat "yaziboy", "Yazi Yuksekligi:", 0.35, 2
  bd.Getfloat "satirar", "Satir Araligi:", 0.55, 2
  bd.Getstring "hatcapi", "Hat Capi Metni:", "O200BB", 20

  If Not bd.showmodal Then
    Exit Sub
  End If

  yaziboy = bd.ValueByName("yaziboy")
  satirar = bd.ValueByName("satirar")
  hatcapi = bd.ValueByName("hatcapi")

  tabNo = .CreateLayer("PARSEL_BACA_BILGI", 6)

  ' ===========================================================
  ' ANA DONGU
  ' ===========================================================
  devamMi = True

  Do While devamMi

    sayac = sayac + 1

    .setparam beginblock, true

    ' ---------------------------------------------------------
    ' 1. HAT CIZGISINI SEC
    ' ---------------------------------------------------------
    set selHat = .NewSelectionSet
    set oHat = .NewObject

    If Not selHat.SELECT("1/7 - Hat cizgisini secin", Array(oline, opline)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selHat.GetSelectedObject(0, oHat)

    hatYatayMesafe = 0
    hatEgikMesafe = 0

    If oHat.tag = oline Then
      dx = oHat.p2.x - oHat.p1.x
      dy = oHat.p2.y - oHat.p1.y
      dz = oHat.p2.z - oHat.p1.z
      hatYatayMesafe = Sqr(dx * dx + dy * dy)
      hatEgikMesafe = Sqr(dx * dx + dy * dy + dz * dz)
    ElseIf oHat.tag = opline Then
      set pExt = .GetPlineExt(oHat)
      For k = 0 To pExt.num - 2
        dx = pExt.cor(k + 1).x - pExt.cor(k).x
        dy = pExt.cor(k + 1).y - pExt.cor(k).y
        dz = pExt.cor(k + 1).z - pExt.cor(k).z
        hatYatayMesafe = hatYatayMesafe + Sqr(dx * dx + dy * dy)
        hatEgikMesafe = hatEgikMesafe + Sqr(dx * dx + dy * dy + dz * dz)
      Next
    End If

    ' ---------------------------------------------------------
    ' 2. C ZEMIN KOTU NOKTASINI SEC
    ' ---------------------------------------------------------
    set selNokta = .NewSelectionSet
    set oC = .NewObject

    If Not selNokta.SELECT("2/7 - C noktasinin ZEMIN KOTU noktasini secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selNokta.GetSelectedObject(0, oC)
    cNoktaAdi = oC.pname
    cZK = oC.p1.z

    ' ---------------------------------------------------------
    ' 3. C AKAR KOTU NOKTASINI SEC
    ' ---------------------------------------------------------
    set selNokta = .NewSelectionSet
    set oCAK = .NewObject

    If Not selNokta.SELECT("3/7 - C noktasinin AKAR KOTU noktasini secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selNokta.GetSelectedObject(0, oCAK)
    cAK = oCAK.p1.z

    ' ---------------------------------------------------------
    ' 4. PARSEL BACA ZEMIN KOTU NOKTASINI SEC
    ' ---------------------------------------------------------
    set selNokta = .NewSelectionSet
    set oBaca = .NewObject

    If Not selNokta.SELECT("4/7 - Parsel bacasi ZEMIN KOTU noktasini secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selNokta.GetSelectedObject(0, oBaca)
    parselBacaAdi = oBaca.pname
    pZK = oBaca.p1.z

    ' ---------------------------------------------------------
    ' 5. PARSEL BACA AKAR KOTU NOKTASINI SEC
    ' ---------------------------------------------------------
    set selNokta = .NewSelectionSet
    set oBacaAK = .NewObject

    If Not selNokta.SELECT("5/7 - Parsel bacasi AKAR KOTU noktasini secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selNokta.GetSelectedObject(0, oBacaAK)
    pAK = oBacaAK.p1.z

    ' ---------------------------------------------------------
    ' HESAPLAMALAR
    ' ---------------------------------------------------------
    If hatEgikMesafe <= 0 Or hatEgikMesafe = hatYatayMesafe Then
      deltaZ = Abs(pZK - cZK)
      If deltaZ > 0 Then
        hatEgikMesafe = Sqr(hatYatayMesafe * hatYatayMesafe + deltaZ * deltaZ)
      End If
    End If

    ' ---------------------------------------------------------
    ' 6. PARSEL BACA TEXT GRUBU - ekrandan serbest koordinat sec
    ' ---------------------------------------------------------
    set cr = .newc(0, 0, 0)
    If Not .SelectPoint("6/7 - PARSEL BACA textlerini yerlestirmek icin ekrana tiklayin", cr, -1) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    yerX = cr.x
    yerY = cr.y

    .AddObject (.MakeText(.newc(yerX, yerY, 0), parselBacaAdi, 0, 0, yaziboy, 0, "1", tabNo))
    .AddObject (.MakeText(.newc(yerX, yerY - satirar, 0), "ZK:" & KotFormat(pZK), 0, 0, yaziboy, 0, "1", tabNo))
    .AddObject (.MakeText(.newc(yerX, yerY - satirar * 2, 0), "AK:" & KotFormat(pAK), 0, 0, yaziboy, 0, "1", tabNo))
    .AddObject (.MakeText(.newc(yerX, yerY - satirar * 3, 0), "YL=" & KotFormat(hatYatayMesafe) & "m", 0, 0, yaziboy, 0, "1", tabNo))
    .AddObject (.MakeText(.newc(yerX, yerY - satirar * 4, 0), "EL=" & KotFormat(hatEgikMesafe) & "m", 0, 0, yaziboy, 0, "1", tabNo))
    .AddObject (.MakeText(.newc(yerX, yerY - satirar * 5, 0), hatcapi, 0, 0, yaziboy, 0, "1", tabNo))

    ' ---------------------------------------------------------
    ' 7. C BAGLANTI TEXT GRUBU - ekrandan serbest koordinat sec
    ' ---------------------------------------------------------
    set cr = .newc(0, 0, 0)
    If Not .SelectPoint("7/7 - C BAGLANTI textlerini yerlestirmek icin ekrana tiklayin", cr, -1) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    yerX = cr.x
    yerY = cr.y

    .AddObject (.MakeText(.newc(yerX, yerY, 0), cNoktaAdi, 0, 0, yaziboy, 0, "1", tabNo))
    .AddObject (.MakeText(.newc(yerX, yerY - satirar, 0), "ZK:" & KotFormat(cZK), 0, 0, yaziboy, 0, "1", tabNo))
    .AddObject (.MakeText(.newc(yerX, yerY - satirar * 2, 0), "AK:" & KotFormat(cAK), 0, 0, yaziboy, 0, "1", tabNo))

    ' ---------------------------------------------------------
    .setparam endblock, true

    ' ---------------------------------------------------------
    ' DEVAM KONTROLU
    ' ---------------------------------------------------------
    Dim sorgu
    sorgu = MsgBox("Baglanti #" & sayac & " tamamlandi." & Chr(13) & Chr(13) & _
      "Baca: " & parselBacaAdi & " ZK:" & KotFormat(pZK) & " AK:" & KotFormat(pAK) & Chr(13) & _
      "C: " & cNoktaAdi & " ZK:" & KotFormat(cZK) & " AK:" & KotFormat(cAK) & Chr(13) & _
      "YL=" & KotFormat(hatYatayMesafe) & "m  EL=" & KotFormat(hatEgikMesafe) & "m" & Chr(13) & Chr(13) & _
      "Devam?", 4, "Parsel Baca Makrosu")

    If sorgu = 6 Then
      devamMi = True
    Else
      devamMi = False
    End If

  Loop

End With

MsgBox "Toplam " & sayac & " baglanti islendi.", 64, "Parsel Baca Makrosu"

END SUB

' ===========================================================================
Function KotFormat(deger)
  Dim tamKisim, ondalikKisim, tempDeger, isaret

  If deger < 0 Then
    isaret = "-"
    tempDeger = -deger
  Else
    isaret = ""
    tempDeger = CDbl(deger)
  End If

  tamKisim = Int(tempDeger)
  ondalikKisim = Int((tempDeger - tamKisim) * 100 + 0.5)

  If ondalikKisim >= 100 Then
    tamKisim = tamKisim + 1
    ondalikKisim = 0
  End If

  If ondalikKisim < 10 Then
    KotFormat = isaret & CStr(tamKisim) & ".0" & CStr(ondalikKisim)
  Else
    KotFormat = isaret & CStr(tamKisim) & "." & CStr(ondalikKisim)
  End If
End Function
