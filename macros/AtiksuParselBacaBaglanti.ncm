'===========================================================================
' ATIKSU PARSEL BACA BAGLANTI BILGILERI YAZMA MAKROSU
' NetCAD NCM Macro
'
' Islem Sirasi:
'   1. C baglanti noktasi secilir
'   2. Parsel baca noktasi secilir
'   3. Ikisi arasindaki hat cizgisi secilir
'   4. C noktasi zemin noktasi secilir (ZK ve AK okunur)
'   5. Parsel bacasi zemin noktasi secilir (ZK ve AK okunur)
'   6. Bilgiler hesaplanir ve gorseldeki formatta yazilir
'   7. Kullanici isterse bir sonraki baglantiya gecer
'===========================================================================

Sub Main()

    Dim cBagX
    Dim cBagY
    Dim cBagZ
    Dim parselX
    Dim parselY
    Dim parselZ
    Dim cNoktaAdi
    Dim parselBacaAdi
    Dim cZK
    Dim cAK
    Dim pZK
    Dim pAK
    Dim hatYatayMesafe
    Dim hatEgikMesafe
    Dim hatAci
    Dim hatAciDerece
    Dim deltaZ
    Dim dx
    Dim dy
    Dim entId
    Dim entType
    Dim sonuc
    Dim yaziX
    Dim yaziY
    Dim perpX
    Dim perpY
    Dim satirSayaci
    Dim yaziAci
    Dim ortaX
    Dim ortaY
    Dim mesafeYaziX
    Dim mesafeYaziY
    Dim tx
    Dim ty
    Dim metin
    Dim devamMi
    Dim yaziYukseklik
    Dim satirAraligi
    Dim noktaOffset
    Dim yaziRenk
    Dim hatCapiMetin
    Dim katmanAdi
    Dim tempVal
    Dim sayac

    ' Yapilandirma
    yaziYukseklik = 0.35
    satirAraligi = 0.55
    noktaOffset = 0.5
    yaziRenk = 6
    hatCapiMetin = "Ø200BB"
    katmanAdi = "PARSEL_BACA_BILGI"
    sayac = 0

    ' Kullanicidan yapilandirma iste
    tempVal = InputBox("Yazi yuksekligi (varsayilan 0.35):", "Ayarlar", "0.35")
    If tempVal <> "" Then
        yaziYukseklik = CDbl(tempVal)
    End If

    tempVal = InputBox("Satir araligi (varsayilan 0.55):", "Ayarlar", "0.55")
    If tempVal <> "" Then
        satirAraligi = CDbl(tempVal)
    End If

    tempVal = InputBox("Hat capi metni (varsayilan Ø200BB):", "Ayarlar", "Ø200BB")
    If tempVal <> "" Then
        hatCapiMetin = tempVal
    End If

    ' Katman ayarla
    NCSetLayer katmanAdi

    ' ===============================================================
    ' ANA DONGU - Coklu baglanti islemi
    ' ===============================================================
    devamMi = True

    Do While devamMi

        sayac = sayac + 1

        ' -----------------------------------------------------------
        ' 1. ADIM: C Baglanti Noktasini Sec
        ' -----------------------------------------------------------
        sonuc = NCInputPoint("1/5 - C baglanti noktasini secin:", cBagX, cBagY, cBagZ)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        ' -----------------------------------------------------------
        ' 2. ADIM: Parsel Baca Noktasini Sec
        ' -----------------------------------------------------------
        sonuc = NCInputPoint("2/5 - Parsel baca noktasini secin:", parselX, parselY, parselZ)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        ' -----------------------------------------------------------
        ' 3. ADIM: Hat Cizgisini Sec
        ' -----------------------------------------------------------
        sonuc = NCInputEntity("3/5 - Hat cizgisini secin:", entType, entId)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        hatYatayMesafe = NCGetLineLength2D(entId)
        hatEgikMesafe = NCGetLineLength3D(entId)

        ' -----------------------------------------------------------
        ' 4. ADIM: C Noktasi Zemin Noktasini Sec
        ' -----------------------------------------------------------
        sonuc = NCInputEntity("4/5 - C noktasinin zemin noktasini secin:", entType, entId)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        cNoktaAdi = NCGetEntityName(entId)
        cZK = NCGetEntityZ(entId)

        ' AK degerini okumaya calis, bulunamazsa kullanicidan iste
        cAK = 0
        On Error Resume Next
        cAK = NCGetProperty(entId, "AK")
        On Error GoTo 0
        If cAK = 0 Then
            tempVal = InputBox("C noktasi (" & cNoktaAdi & ") Akar Kotu (AK) bulunamadi." & Chr(13) & "AK degerini girin:", "AK Girisi", "0.00")
            If tempVal <> "" Then
                cAK = CDbl(tempVal)
            End If
        End If

        ' -----------------------------------------------------------
        ' 5. ADIM: Parsel Bacasi Zemin Noktasini Sec
        ' -----------------------------------------------------------
        sonuc = NCInputEntity("5/5 - Parsel bacasi zemin noktasini secin:", entType, entId)
        If Not sonuc Then
            MsgBox "Islem iptal edildi."
            Exit Sub
        End If

        parselBacaAdi = NCGetEntityName(entId)
        pZK = NCGetEntityZ(entId)

        ' AK degerini okumaya calis, bulunamazsa kullanicidan iste
        pAK = 0
        On Error Resume Next
        pAK = NCGetProperty(entId, "AK")
        On Error GoTo 0
        If pAK = 0 Then
            tempVal = InputBox("Parsel bacasi (" & parselBacaAdi & ") Akar Kotu (AK) bulunamadi." & Chr(13) & "AK degerini girin:", "AK Girisi", "0.00")
            If tempVal <> "" Then
                pAK = CDbl(tempVal)
            End If
        End If

        ' -----------------------------------------------------------
        ' Hesaplamalar
        ' -----------------------------------------------------------
        dx = parselX - cBagX
        dy = parselY - cBagY
        hatAci = HesaplaAtn2(dy, dx)
        hatAciDerece = hatAci * 57.2957795130823

        ' Egik mesafe dogrulamasi
        If hatEgikMesafe <= 0 Then
            deltaZ = Abs(pZK - cZK)
            hatEgikMesafe = Sqr(hatYatayMesafe * hatYatayMesafe + deltaZ * deltaZ)
        End If

        ' Yazi acisi (-90 ile 90 derece arasi okunaklilik icin)
        yaziAci = hatAciDerece
        If yaziAci > 90 Then
            yaziAci = yaziAci - 180
        End If
        If yaziAci < -90 Then
            yaziAci = yaziAci + 180
        End If

        ' Dik yon (text offseti icin)
        perpX = -Sin(hatAci)
        perpY = Cos(hatAci)

        ' -----------------------------------------------------------
        ' YAZI RENGI AYARLA
        ' -----------------------------------------------------------
        NCSetColor yaziRenk

        ' -----------------------------------------------------------
        ' PARSEL BACA BILGILERINI YAZ (6 satir, baca noktasinda)
        ' -----------------------------------------------------------
        satirSayaci = 0
        yaziX = parselX + perpX * noktaOffset
        yaziY = parselY + perpY * noktaOffset

        ' Satir 0: Baca Adi
        tx = yaziX + perpX * satirAraligi * satirSayaci
        ty = yaziY + perpY * satirAraligi * satirSayaci
        NCCreateText parselBacaAdi, tx, ty, yaziYukseklik, yaziAci
        satirSayaci = satirSayaci + 1

        ' Satir 1: Zemin Kotu
        metin = "ZK:" & KotFormat(pZK)
        tx = yaziX + perpX * satirAraligi * satirSayaci
        ty = yaziY + perpY * satirAraligi * satirSayaci
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci
        satirSayaci = satirSayaci + 1

        ' Satir 2: Akar Kotu
        metin = "AK:" & KotFormat(pAK)
        tx = yaziX + perpX * satirAraligi * satirSayaci
        ty = yaziY + perpY * satirAraligi * satirSayaci
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci
        satirSayaci = satirSayaci + 1

        ' Satir 3: Yatay Mesafe
        metin = "YL=" & KotFormat(hatYatayMesafe) & "m"
        tx = yaziX + perpX * satirAraligi * satirSayaci
        ty = yaziY + perpY * satirAraligi * satirSayaci
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci
        satirSayaci = satirSayaci + 1

        ' Satir 4: Egik Mesafe
        metin = "EL=" & KotFormat(hatEgikMesafe) & "m"
        tx = yaziX + perpX * satirAraligi * satirSayaci
        ty = yaziY + perpY * satirAraligi * satirSayaci
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci
        satirSayaci = satirSayaci + 1

        ' Satir 5: Hat Capi (sabit)
        tx = yaziX + perpX * satirAraligi * satirSayaci
        ty = yaziY + perpY * satirAraligi * satirSayaci
        NCCreateText hatCapiMetin, tx, ty, yaziYukseklik, yaziAci

        ' -----------------------------------------------------------
        ' C BAGLANTI NOKTASI BILGILERINI YAZ (3 satir)
        ' -----------------------------------------------------------
        satirSayaci = 0
        yaziX = cBagX + perpX * noktaOffset
        yaziY = cBagY + perpY * noktaOffset

        ' C Nokta Adi
        tx = yaziX + perpX * satirAraligi * satirSayaci
        ty = yaziY + perpY * satirAraligi * satirSayaci
        NCCreateText cNoktaAdi, tx, ty, yaziYukseklik, yaziAci
        satirSayaci = satirSayaci + 1

        ' C Zemin Kotu
        metin = "ZK:" & KotFormat(cZK)
        tx = yaziX + perpX * satirAraligi * satirSayaci
        ty = yaziY + perpY * satirAraligi * satirSayaci
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci
        satirSayaci = satirSayaci + 1

        ' C Akar Kotu
        metin = "AK:" & KotFormat(cAK)
        tx = yaziX + perpX * satirAraligi * satirSayaci
        ty = yaziY + perpY * satirAraligi * satirSayaci
        NCCreateText metin, tx, ty, yaziYukseklik, yaziAci

        ' -----------------------------------------------------------
        ' HAT ORTASINA MESAFE BILGISI YAZ
        ' -----------------------------------------------------------
        ortaX = (cBagX + parselX) / 2
        ortaY = (cBagY + parselY) / 2
        mesafeYaziX = ortaX + perpX * (noktaOffset * 0.5)
        mesafeYaziY = ortaY + perpY * (noktaOffset * 0.5)
        metin = KotFormat(hatYatayMesafe)
        NCCreateText metin, mesafeYaziX, mesafeYaziY, yaziYukseklik, yaziAci

        ' -----------------------------------------------------------
        ' Devam kontrolu
        ' -----------------------------------------------------------
        tempVal = MsgBox("Baglanti #" & sayac & " tamamlandi." & Chr(13) & Chr(13) & "Baca: " & parselBacaAdi & Chr(13) & "C Noktasi: " & cNoktaAdi & Chr(13) & "YL=" & KotFormat(hatYatayMesafe) & "m  EL=" & KotFormat(hatEgikMesafe) & "m" & Chr(13) & Chr(13) & "Bir sonraki baglantiya devam etmek ister misiniz?", 4, "Parsel Baca Makrosu")

        If tempVal = 6 Then
            devamMi = True
        Else
            devamMi = False
        End If

    Loop

    MsgBox "Makro tamamlandi. Toplam " & sayac & " baglanti islendi."

End Sub

' ===========================================================================
' Kot degerini 2 ondalikli string olarak formatla
' ===========================================================================
Function KotFormat(deger)
    Dim tamKisim
    Dim ondalikKisim
    Dim tempDeger
    Dim isaret

    If deger < 0 Then
        isaret = "-"
        tempDeger = -deger
    Else
        isaret = ""
        tempDeger = deger
    End If

    tamKisim = Int(tempDeger)
    ondalikKisim = Int((tempDeger - tamKisim) * 100 + 0.5)

    If ondalikKisim >= 100 Then
        tamKisim = tamKisim + 1
        ondalikKisim = 0
    End If

    If ondalikKisim < 10 Then
        KotFormat = isaret & CStr(tamKisim) & ".0" & CStr(ondalikKisim)
    Else
        KotFormat = isaret & CStr(tamKisim) & "." & CStr(ondalikKisim)
    End If
End Function

' ===========================================================================
' Atan2 hesaplama (iki parametreli arkus tanjant)
' ===========================================================================
Function HesaplaAtn2(y, x)
    Dim myPI
    myPI = 3.14159265358979
    If x > 0 Then
        HesaplaAtn2 = Atn(y / x)
    ElseIf x < 0 And y >= 0 Then
        HesaplaAtn2 = Atn(y / x) + myPI
    ElseIf x < 0 And y < 0 Then
        HesaplaAtn2 = Atn(y / x) - myPI
    ElseIf x = 0 And y > 0 Then
        HesaplaAtn2 = myPI / 2
    ElseIf x = 0 And y < 0 Then
        HesaplaAtn2 = -myPI / 2
    Else
        HesaplaAtn2 = 0
    End If
End Function
