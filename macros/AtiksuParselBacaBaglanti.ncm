'===========================================================================
' ATIKSU PARSEL BACA BAGLANTI BILGILERI YAZMA MAKROSU
' NetCAD VBScript Macro
'
' Islem Sirasi:
'   1. Hat cizgisi secilir (yatay ve egik mesafe hesaplanir)
'   2. C zemin noktasi secilir (ad, ZK okunur, AK sorulur)
'   3. Parsel baca zemin noktasi secilir (ad, ZK okunur, AK sorulur)
'   4. Parsel Baca text grubu icin yerlestirme noktasi secilir
'   5. C Baglanti text grubu icin yerlestirme noktasi secilir
'   6. Devam/Cik
'
' Text Gruplari:
'   PARSEL BACA (6 satir): Ad, ZK, AK, YL, EL, Cap
'   C BAGLANTI  (3 satir): Ad, ZK, AK
'
' NetCAD Obje Ozellikleri:
'   Nokta: o.p1.x, o.p1.y, o.p1.z, o.pname
'   Cizgi: o.p1.x/y/z, o.p2.x/y/z (baslangic/bitis)
'   Polyline: GetPlineExt(o) -> p.num, p.cor(i).x/y/z
'   Sabitler: opoint=1, oline=2, opline=7
'===========================================================================

SUB Main

DIM selHat, selNokta, selYer
DIM o, oHat, oC, oBaca, oYer
DIM i, j, k, bd, pExt
DIM cNoktaAdi, parselBacaAdi
DIM cZK, cAK, pZK, pAK
DIM hatYatayMesafe, hatEgikMesafe
DIM yaziboy, satirar, hatcapi
DIM hatAci, yaziAci, perpX, perpY
DIM yerX, yerY, tx, ty
DIM tabNo, devamMi, sayac
DIM deltaZ, dx, dy, dz, myPI
DIM segYatay, segEgik

myPI = 3.14159265358979
sayac = 0

With netcad

  ' -----------------------------------------------------------
  ' AYAR DIYALOGU
  ' -----------------------------------------------------------
  set bd = Netcad.NewBDialog("Atiksu Parsel Baca Baglanti Ayarlari")
  bd.Getfloat "yaziboy", "Yazi Yuksekligi:", 0.35, 2
  bd.Getfloat "satirar", "Satir Araligi:", 0.55, 2
  bd.Getstring "hatcapi", "Hat Capi Metni:", "O200BB", 20

  If Not bd.showmodal Then
    Exit Sub
  End If

  yaziboy = bd.ValueByName("yaziboy")
  satirar = bd.ValueByName("satirar")
  hatcapi = bd.ValueByName("hatcapi")

  tabNo = .CreateLayer("PARSEL_BACA_BILGI", 6)

  ' ===========================================================
  ' ANA DONGU
  ' ===========================================================
  devamMi = True

  Do While devamMi

    sayac = sayac + 1

    set selHat = .NewSelectionSet
    set selNokta = .NewSelectionSet
    set selYer = .NewSelectionSet
    set oHat = .NewObject
    set oC = .NewObject
    set oBaca = .NewObject
    set oYer = .NewObject

    .setparam beginblock, true

    ' ---------------------------------------------------------
    ' 1. HAT CIZGISINI SEC
    ' ---------------------------------------------------------
    If Not selHat.SELECT("1/5 - Hat cizgisini secin", Array(oline, opline)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selHat.GetSelectedObject(0, oHat)

    hatYatayMesafe = 0
    hatEgikMesafe = 0

    If oHat.tag = oline Then
      dx = oHat.p2.x - oHat.p1.x
      dy = oHat.p2.y - oHat.p1.y
      dz = oHat.p2.z - oHat.p1.z
      hatYatayMesafe = Sqr(dx * dx + dy * dy)
      hatEgikMesafe = Sqr(dx * dx + dy * dy + dz * dz)
    ElseIf oHat.tag = opline Then
      set pExt = .GetPlineExt(oHat)
      For k = 0 To pExt.num - 2
        dx = pExt.cor(k + 1).x - pExt.cor(k).x
        dy = pExt.cor(k + 1).y - pExt.cor(k).y
        dz = pExt.cor(k + 1).z - pExt.cor(k).z
        hatYatayMesafe = hatYatayMesafe + Sqr(dx * dx + dy * dy)
        hatEgikMesafe = hatEgikMesafe + Sqr(dx * dx + dy * dy + dz * dz)
      Next
    End If

    ' ---------------------------------------------------------
    ' 2. C ZEMIN NOKTASINI SEC
    ' ---------------------------------------------------------
    If Not selNokta.SELECT("2/5 - C noktasinin zemin noktasini secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selNokta.GetSelectedObject(0, oC)
    cNoktaAdi = oC.pname
    cZK = oC.p1.z

    cAK = 0
    On Error Resume Next
    cAK = CDbl(oC.pcode)
    On Error GoTo 0
    If cAK = 0 Then
      cAK = CDbl(InputBox("C noktasi (" & cNoktaAdi & ") AK noktadan okunamadi. AK girin:", "AK Girisi", "0.00"))
    End If

    ' ---------------------------------------------------------
    ' 3. PARSEL BACA ZEMIN NOKTASINI SEC
    ' ---------------------------------------------------------
    set selNokta = .NewSelectionSet
    If Not selNokta.SELECT("3/5 - Parsel bacasi zemin noktasini secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selNokta.GetSelectedObject(0, oBaca)
    parselBacaAdi = oBaca.pname
    pZK = oBaca.p1.z

    pAK = 0
    On Error Resume Next
    pAK = CDbl(oBaca.pcode)
    On Error GoTo 0
    If pAK = 0 Then
      pAK = CDbl(InputBox("Parsel bacasi (" & parselBacaAdi & ") AK noktadan okunamadi. AK girin:", "AK Girisi", "0.00"))
    End If

    ' ---------------------------------------------------------
    ' HESAPLAMALAR
    ' ---------------------------------------------------------
    dx = oBaca.p1.x - oC.p1.x
    dy = oBaca.p1.y - oC.p1.y

    If dx = 0 And dy = 0 Then
      hatAci = 0
    ElseIf dx = 0 Then
      If dy > 0 Then hatAci = myPI / 2 Else hatAci = -myPI / 2
    Else
      hatAci = Atn(dy / dx)
      If dx < 0 Then hatAci = hatAci + myPI
    End If

    If hatEgikMesafe <= 0 Or hatEgikMesafe = hatYatayMesafe Then
      deltaZ = Abs(pZK - cZK)
      If deltaZ > 0 Then
        hatEgikMesafe = Sqr(hatYatayMesafe * hatYatayMesafe + deltaZ * deltaZ)
      End If
    End If

    yaziAci = hatAci * 57.2957795130823
    If yaziAci > 90 Then yaziAci = yaziAci - 180
    If yaziAci < -90 Then yaziAci = yaziAci + 180

    perpX = -Sin(hatAci)
    perpY = Cos(hatAci)

    ' ---------------------------------------------------------
    ' 4. PARSEL BACA TEXT GRUBUNU YERLESTIR (6 satir)
    ' ---------------------------------------------------------
    set selYer = .NewSelectionSet
    If Not selYer.SELECT("4/5 - PARSEL BACA text grubunu koyacaginiz NOKTAYI secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selYer.GetSelectedObject(0, oYer)
    yerX = oYer.p1.x
    yerY = oYer.p1.y

    tx = yerX
    ty = yerY
    set o = .NewObject
    o.p1.x = tx : o.p1.y = ty : o.p1.z = 0
    .AddObject (.MakeText(o.p1, parselBacaAdi, yaziAci, 0, yaziboy, 0, "L", tabNo))

    tx = yerX + perpX * satirar
    ty = yerY + perpY * satirar
    o.p1.x = tx : o.p1.y = ty : o.p1.z = 0
    .AddObject (.MakeText(o.p1, "ZK:" & KotFormat(pZK), yaziAci, 0, yaziboy, 0, "L", tabNo))

    tx = yerX + perpX * satirar * 2
    ty = yerY + perpY * satirar * 2
    o.p1.x = tx : o.p1.y = ty : o.p1.z = 0
    .AddObject (.MakeText(o.p1, "AK:" & KotFormat(pAK), yaziAci, 0, yaziboy, 0, "L", tabNo))

    tx = yerX + perpX * satirar * 3
    ty = yerY + perpY * satirar * 3
    o.p1.x = tx : o.p1.y = ty : o.p1.z = 0
    .AddObject (.MakeText(o.p1, "YL=" & KotFormat(hatYatayMesafe) & "m", yaziAci, 0, yaziboy, 0, "L", tabNo))

    tx = yerX + perpX * satirar * 4
    ty = yerY + perpY * satirar * 4
    o.p1.x = tx : o.p1.y = ty : o.p1.z = 0
    .AddObject (.MakeText(o.p1, "EL=" & KotFormat(hatEgikMesafe) & "m", yaziAci, 0, yaziboy, 0, "L", tabNo))

    tx = yerX + perpX * satirar * 5
    ty = yerY + perpY * satirar * 5
    o.p1.x = tx : o.p1.y = ty : o.p1.z = 0
    .AddObject (.MakeText(o.p1, hatcapi, yaziAci, 0, yaziboy, 0, "L", tabNo))

    ' ---------------------------------------------------------
    ' 5. C BAGLANTI TEXT GRUBUNU YERLESTIR (3 satir)
    ' ---------------------------------------------------------
    set selYer = .NewSelectionSet
    If Not selYer.SELECT("5/5 - C BAGLANTI text grubunu koyacaginiz NOKTAYI secin", Array(opoint)) Then
      MsgBox "Islem iptal edildi."
      Exit Sub
    End If

    j = selYer.GetSelectedObject(0, oYer)
    yerX = oYer.p1.x
    yerY = oYer.p1.y

    tx = yerX
    ty = yerY
    o.p1.x = tx : o.p1.y = ty : o.p1.z = 0
    .AddObject (.MakeText(o.p1, cNoktaAdi, yaziAci, 0, yaziboy, 0, "L", tabNo))

    tx = yerX + perpX * satirar
    ty = yerY + perpY * satirar
    o.p1.x = tx : o.p1.y = ty : o.p1.z = 0
    .AddObject (.MakeText(o.p1, "ZK:" & KotFormat(cZK), yaziAci, 0, yaziboy, 0, "L", tabNo))

    tx = yerX + perpX * satirar * 2
    ty = yerY + perpY * satirar * 2
    o.p1.x = tx : o.p1.y = ty : o.p1.z = 0
    .AddObject (.MakeText(o.p1, "AK:" & KotFormat(cAK), yaziAci, 0, yaziboy, 0, "L", tabNo))

    ' ---------------------------------------------------------
    .setparam endblock, true

    ' ---------------------------------------------------------
    ' DEVAM KONTROLU
    ' ---------------------------------------------------------
    Dim sorgu
    sorgu = MsgBox("Baglanti #" & sayac & " tamamlandi." & Chr(13) & Chr(13) & "Baca: " & parselBacaAdi & Chr(13) & "C: " & cNoktaAdi & Chr(13) & Chr(13) & "Devam?", 4, "Parsel Baca Makrosu")

    If sorgu = 6 Then
      devamMi = True
    Else
      devamMi = False
    End If

    set selHat = Nothing
    set selNokta = Nothing
    set selYer = Nothing

  Loop

End With

MsgBox "Toplam " & sayac & " baglanti islendi.", 64, "Parsel Baca Makrosu"

END SUB

' ===========================================================================
Function KotFormat(deger)
  Dim tamKisim, ondalikKisim, tempDeger, isaret

  If deger < 0 Then
    isaret = "-"
    tempDeger = -deger
  Else
    isaret = ""
    tempDeger = CDbl(deger)
  End If

  tamKisim = Int(tempDeger)
  ondalikKisim = Int((tempDeger - tamKisim) * 100 + 0.5)

  If ondalikKisim >= 100 Then
    tamKisim = tamKisim + 1
    ondalikKisim = 0
  End If

  If ondalikKisim < 10 Then
    KotFormat = isaret & CStr(tamKisim) & ".0" & CStr(ondalikKisim)
  Else
    KotFormat = isaret & CStr(tamKisim) & "." & CStr(ondalikKisim)
  End If
End Function
